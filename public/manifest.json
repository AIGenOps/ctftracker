{
  "manifest_version": 3,
  "name": "CTF Tracker",
  "version": "1.0.0",
  "description": "Detects CTF competitions, tracks participation, and delivers timely start and deadline reminders.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CTF Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ctftime.org/*",
        "https://*.ctfd.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://ctftime.org/*",
    "https://*.ctfd.io/*"
  ]
}
